    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects to the Bluetooth OBD-II adapter to read live DPF data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conecta al adaptador OBD-II Bluetooth para leer los datos del DPF en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecte à l’adaptateur OBD-II Bluetooth pour lire les données DPF en temps réel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si connette all’adattatore OBD-II Bluetooth per leggere i dati DPF in tempo reale."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects to the Wi-Fi OBD-II adapter on the local network to read live DPF data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conecta al adaptador OBD-II Wi-Fi de la red local para leer los datos del DPF en tiempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecte à l’adaptateur OBD-II Wi-Fi sur le réseau local pour lire les données DPF en temps réel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si connette all’adattatore OBD-II Wi-Fi sulla rete locale per leggere i dati DPF in tempo reale."
          }
        }
      }
    }
