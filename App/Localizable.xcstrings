    "Configura l’adattatore e consulta i dati soltanto a veicolo fermo. Non interagire con iPhone durante la guida e rispetta sempre il codice della strada." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura l’adattatore e consulta i dati soltanto a veicolo fermo. Non interagire con iPhone durante la guida e rispetta sempre il codice della strada."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up the adapter and check data only while parked. Do not interact with iPhone while driving, and always obey traffic laws."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez l’adaptateur et consultez les données uniquement à l’arrêt. N’utilisez pas l’iPhone en conduisant et respectez toujours le code de la route."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura el adaptador y consulta los datos solo con el vehículo detenido. No uses el iPhone mientras conduces y respeta siempre las normas de tráfico."
          }
        }
      }
    },
    "Configura la connessione da fermo. Non usare iPhone durante la guida." : {
      "localizations" : {
