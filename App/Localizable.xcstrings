    "Per consentire gli annunci Siri quando supportati, attiva “Annuncia notifiche”" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per consentire gli annunci Siri quando supportati, attiva “Annuncia notifiche”"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To allow Siri announcements when supported, enable “Announce Notifications”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour autoriser les annonces Siri si elles sont prises en charge, activez « Annoncer les notifications »"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para permitir los anuncios de Siri cuando sean compatibles, activa «Anunciar notificaciones»"
          }
        }
      }
    },
    "Per il test sistema, tocca il pulsante e torna subito alla Home CarPlay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per il test sistema, tocca il pulsante e torna subito alla Home CarPlay."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For the system test, tap the button and immediately return to CarPlay Home."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour le test système, touchez le bouton puis revenez immédiatement à l’accueil CarPlay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para la prueba del sistema, toca el botón y vuelve inmediatamente a la pantalla de inicio de CarPlay."
          }
        }
      }
    },
    "Per testare manualmente entrambe le notifiche, tocca prima “Inizio rigenerazione” e poi “Fine rigenerazione”." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per testare manualmente entrambe le notifiche, tocca prima “Inizio rigenerazione” e poi “Fine rigenerazione”."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To test both notifications manually, tap “Regeneration started” first, then “Regeneration finished.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour tester manuellement les deux notifications, touchez d’abord « Début de la régénération », puis « Fin de la régénération »."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para probar manualmente ambas notificaciones, toca primero «Inicio de regeneración» y después «Fin de regeneración»."
          }
        }
      }
    },
