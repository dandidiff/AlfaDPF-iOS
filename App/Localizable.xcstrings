    "Full immersion Guida può comunque silenziare l’avviso." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full immersion Guida può comunque silenziare l’avviso."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Driving Focus may still silence the alert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Concentration au volant peut malgré tout réduire l’alerte au silence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Concentración al volante puede silenciar la alerta de todos modos."
          }
        }
      }
    },
    "Gli avvisi di rigenerazione sono informazioni sensibili al tempo. Ti guidiamo una volta sola; poi l’app tenterà automaticamente la connessione all’OBD." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi di rigenerazione sono informazioni sensibili al tempo. Ti guidiamo una volta sola; poi l’app tenterà automaticamente la connessione all’OBD."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneration alerts are time-sensitive. We will guide you through setup once; the app will then automatically try to connect to the OBD."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes de régénération sont sensibles au temps. Nous vous guiderons une seule fois ; l’app tentera ensuite automatiquement de se connecter à l’OBD."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas de regeneración son sensibles al tiempo. Te guiaremos una sola vez; después la app intentará conectarse automáticamente al OBD."
          }
        }
      }
    },
    "Gli scenari usano la stessa logica della connessione reale: interfaccia, Live Activity e notifiche di inizio/fine rigenerazione." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli scenari usano la stessa logica della connessione reale: interfaccia, Live Activity e notifiche di inizio/fine rigenerazione."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scenarios use the same logic as a real connection: interface, Live Activity, and regeneration start/end notifications."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les scénarios utilisent la même logique qu’une connexion réelle : interface, activité en direct et notifications de début/fin de régénération."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los escenarios usan la misma lógica que una conexión real: interfaz, Live Activity y notificaciones de inicio/fin de regeneración."
          }
        }
      }
    },
