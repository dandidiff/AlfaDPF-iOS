<!-- Paste into the real Info.plist. Trimmed to the keys that matter for the
     architecture under review; usage-description strings and the standard
     UIApplicationSceneManifest for the phone scene are omitted. -->
<dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <!-- Deliberately NOT adding "fetch" or "processing": neither will keep
             a Wi-Fi socket alive, and they waste battery. -->
    </array>

    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>CPTemplateApplicationSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>CPTemplateApplicationScene</string>
                    <key>UISceneConfigurationName</key>
                    <string>AlfaDPF CarPlay</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- NSLocalNetworkUsageDescription is required because we open a TCP
         socket to the dongle on the local Wi-Fi network. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Connects to your OBD-II Wi-Fi adapter to read live DPF data.</string>

    <!-- Required entitlement (not a plist key): apply to Apple for
         com.apple.developer.carplay-driving-task. Without it, CarPlay will
         refuse to launch the scene. -->
</dict>
